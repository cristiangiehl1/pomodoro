# Banco (Docker em dev). O host do banco pode continuar sendo localhost.
DATABASE_URL=postgres://pomodoro:pomodoro@localhost:5434/pomodoro

# Em dev, prefira o loopback 127.0.0.1 (e acesse o app por ele): o Spotify
# NÃO aceita mais "http://localhost" como redirect — só HTTPS ou 127.0.0.1.
# Se mudar para 127.0.0.1 aqui, atualize também os callbacks nos OAuth Apps
# do Google e do GitHub para http://127.0.0.1:3000/api/auth/callback/<provider>.
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spotify (conta OAuth linkada via better-auth). No dashboard do Spotify,
# registre EXATAMENTE este Redirect URI (o callback é gerenciado pelo better-auth):
#   http://127.0.0.1:3000/api/auth/oauth2/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
